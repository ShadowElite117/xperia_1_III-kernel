config NTFS3_FS
	tristate "NTFS Read-Write file system support"
	select NLS
	help
	  Windows OS native file system (NTFS) support up to NTFS version 3.1.

	  Y or M enables the NTFS3 driver with full features enabled (read,
	  write, journal replaying, sparse/compressed files support).
	  File system type to use on mount is "ntfs3". Module name (M option)
	  is also "ntfs3".

	  Documentation: <file:Documentation/filesystems/ntfs3.rst>

config NTFS3_64BIT_CLUSTER
	bool "64 bits per NTFS clusters"
	depends on NTFS3_FS && 64BIT
	help
	  Windows implementation of ntfs.sys uses 32 bits per clusters.
	  If activated 64 bits per clusters you will be able to use 4k cluster
	  for 16T+ volumes. Windows will not be able to mount such volumes.

	  It is recommended to say N here.

config NTFS3_LZX_XPRESS
	bool "activate support of external compressions lzx/xpress"
	depends on NTFS3_FS
	help
	  In Windows 10 one can use command "compact" to compress any files.
	  4 possible variants of compression are: xpress4k, xpress8k, xpress16k and lzx.
	  If activated you will be able to read such files correctly.

	  It is recommended to say Y here.

config NTFS3_TEXFAT_REDIRECT
	bool "Mount NTFS volumes requested as texfat with ntfs3"
	depends on NTFS3_FS=y
	help
	  Android's vold on Sony devices mounts exFAT volumes with the vendor
	  "texfat" driver and has no NTFS support. With this option, a mount
	  request for "texfat" on a volume whose boot sector identifies it as
	  NTFS is served by ntfs3 instead. exFAT volumes are not affected.

	  Together with a userspace helper that reports NTFS volumes to vold
	  as exFAT, this makes NTFS USB drives and SD cards show up as normal
	  removable storage. Without such a helper this option does nothing.

	  If unsure, say N.

config NTFS3_FS_POSIX_ACL
	bool "NTFS POSIX Access Control Lists"
	# Not ported to Linux 5.4 (get_acl/set_acl and the ACL xattr handlers)
	depends on NTFS3_FS && BROKEN
	select FS_POSIX_ACL
	help
	  POSIX Access Control Lists (ACLs) support additional access rights
	  for users and groups beyond the standard owner/group/world scheme,
	  and this option selects support for ACLs specifically for ntfs
	  filesystems.
	  NOTE: this is linux only feature. Windows will ignore these ACLs.

	  If you don't know what Access Control Lists are, say N.
