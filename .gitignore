*.lzo
*.mod
*.mod.c
*.o
*.o.*
*.order
*.patch
*.s
*.so
*.so.dbg
*.su
*.symtypes
*.tab.[ch]
*.tar
*.xz
Module.symvers
modules.builtin
modules.order

# Raíz: imágenes y mapas generados
/vmlinux
/vmlinux.32
/vmlinux-gdb.py
/vmlinuz
/System.map
/Module.markers
/modules.builtin.modinfo
/modules.nsdeps
/abi.xml
/abi_symbollist.raw

# Generados en include/
/include/config/
/include/generated/
/include/ksym/
/arch/*/include/generated/
/usr/include/*
!/usr/include/Makefile
/usr/initramfs_data.cpio*
!/scripts/Makefile.dtbo

