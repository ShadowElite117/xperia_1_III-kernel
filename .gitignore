# ---------------------------------------------------------------------------
# Claude Code: configuración y contexto locales, no forman parte del kernel
# ---------------------------------------------------------------------------
/CLAUDE.md
/CLAUDE.local.md
.claude/

# ---------------------------------------------------------------------------
# Compilación fuera del árbol y salidas propias
# ---------------------------------------------------------------------------
/out/
/dist/
*.img
*.zip

# Defconfig generado por scripts/gki/generate_defconfig.sh
/arch/arm64/configs/vendor/lahaina-*_defconfig
/arch/arm64/configs/vendor/*_ALLYES_GKI.config

# ---------------------------------------------------------------------------
# Artefactos de compilación del kernel (por si se compila dentro del árbol;
# Sony eliminó todos los .gitignore originales de la liberación)
# ---------------------------------------------------------------------------
.*
!.gitignore
!.mailmap
!.cocciconfig
!.clang-format
!.get_maintainer.ignore
*.a
*.asn1.[ch]
*.bin
*.bz2
*.c.[012]*.*
*.dt.yaml
*.dtb
*.dtb.S
*.dtbo
*.dwo
*.elf
*.gcno
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
