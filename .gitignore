/scripts/basic/fixdep
/scripts/kconfig/conf
/scripts/kconfig/mconf
/scripts/kconfig/nconf
/scripts/kconfig/qconf
/scripts/kconfig/gconf
/scripts/kconfig/*conf-cfg
/scripts/dtc/dtc
/scripts/genksyms/genksyms
/scripts/mod/modpost
/scripts/mod/mk_elfconfig
/scripts/mod/elfconfig.h
/scripts/mod/devicetable-offsets.h
/scripts/kallsyms
/scripts/sortextable
/scripts/asn1_compiler
/scripts/extract-cert
/scripts/sign-file
/scripts/conmakehash
/scripts/recordmcount
/scripts/unifdef
/scripts/selinux/genheaders/genheaders
/scripts/selinux/mdp/mdp
/scripts/gcc-plugins/*.so

# Boot images de arm64 generadas
/arch/arm64/boot/Image*
/arch/arm64/kernel/vdso/vdso.lds
/arch/arm64/kernel/vdso/vdso.so*
/arch/arm64/kernel/vdso32/vdso.lds
